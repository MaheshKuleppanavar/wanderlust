<%layout('layouts/boilerplate')-%>
<div class="row mt-3">
    <h2 class="col-sm-6 offset-sm-3">Signup on Wanderlust</h2>
    <div class="col-sm-6 offset-sm-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
             <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" id="usernmae" class="form-control" type="text" placeholder="" required>
                <div class="invalid-feedback">Username required</div>
            </div>
             <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" class="form-control" type="email" placeholder="" required>
                <div class="invalid-feedback">Email required</div>
            </div>
             <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" id="password" class="form-control" type="password" placeholder="" required>
                <div class="invalid-feedback">Password required</div>
            </div>
             <div class="mb-3">
                Already an existing user?<a href="/login">login</a>
            </div>
            <button class="btn btn-primary">Signup</button>
        </form>
    </div>
</div>